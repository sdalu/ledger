<%# A picture asked of the session on a card that has none; <%== carries only the icons. %>
<div class="picture-ask"><% lines.each do |line| %><p class="asked-line"><%= line %></p><% end %><% if open %><details class="comment-fold" id="<%= lid %>-picture-<%= fid %>"><summary><%== icon("eye") %>Request a picture</summary><form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="<%= ref %>"><fieldset><legend>Which kind</legend><div class="opts"><% kinds.each_with_index do |(value, label), i| %><span class="opt"><input type="radio" id="picture-<%= fid %>-<%= value %>" name="picture" value="<%= value %>"<% if i.zero? %> checked<% end %>><label for="picture-<%= fid %>-<%= value %>"><%= label %></label></span><% end %></div></fieldset><label for="picture-<%= fid %>-text">What should it show?</label><textarea id="picture-<%= fid %>-text" name="text" maxlength="4000" required></textarea><div class="actions"><button type="submit"><%== icon("eye") %>Request picture</button><button type="button" class="a-quote" hidden disabled><%== icon("text-quote") %>Quote last selection</button></div></form></details><% end %></div>
