<%# A comment on a question that answers nothing, folded below its answer form; <%== carries only the icons. %>
<div class="ask-about"><% lines.each do |line| %><p class="asked-line"><%= line %></p><% end %><details class="comment-fold" id="<%= lid %>-ask-<%= ref %>"><summary><%== icon("message-square") %>Ask about <%= ref %></summary><form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="<%= ref %>"><input type="hidden" name="comment" value="1"><label for="say-<%= ref %>-ask">Your question on <%= ref %>: a comment, not an answer</label><textarea id="say-<%= ref %>-ask" name="text" maxlength="4000" required></textarea><div class="actions"><button type="submit"><%== icon("send") %>Send question</button><button type="button" class="a-quote" hidden disabled><%== icon("text-quote") %>Quote last selection</button></div></form></details></div>
