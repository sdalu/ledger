<%# The ledger's Close, folded so one stray click closes nothing: the fold opens the request, its button sends it. %>
<details class="close-fold" id="<%= lid %>-close"><summary><%== icon("archive") %>Close the ledger</summary><form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="close"><h4 class="close-title">Close this ledger?</h4><p class="close-says"><%= says %></p><label for="say-close">Anything to say with it? (optional)</label><textarea id="say-close" name="text" maxlength="4000"></textarea><div class="actions"><button type="button" class="a-cancel" hidden>Cancel</button><button type="submit" class="a-close">Yes, close it</button></div></form></details>
