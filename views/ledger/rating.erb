<%# label: risk, work or step, what the rating rates. %>
<span class="rating" role="img" aria-label="<%= label %> <%= rating %> out of 10"><span class="meter"><% 10.times do |step| %><span<% if step < [rating, 10].min %> class="is-on"<% end %>></span><% end %></span><%= label %> <%= rating %>/10</span>
