<%# <%== carries the icons and the bars. %>
<nav class="tiles" aria-label="Sections"><a class="<%= c.asks.positive? ? "is-ask" : "is-done" %>" href="#waiting"><span class="label"><%== icon("hand") %>Waiting on you</span><span class="figure"><%= c.asks %></span><% unless asked.empty? %><span class="label"><%= asked %></span><% end %></a><% if c.flying.positive? %><a class="is-flight" href="#flight"><span class="label"><%== icon("list-todo") %>Unfinished pieces</span><span class="figure"><%= c.flying %></span><span class="label"><%= c.out %> out · <%= c.blocked %> blocked · <%= c.planned %> planned<% if c.deferred.positive? %> · <%= c.deferred %> deferred<% end %></span></a><% end %><a class="<%= c.crit_met == c.crit ? "is-done" : "is-flight" %>" href="<%= c.crit.positive? && c.crit_met == c.crit ? "##{lid}-criteria-met" : "#criteria" %>"><span class="label"><%== icon("list-checks") %>Criteria</span><span class="figure"><%= c.crit_met %>/<%= c.crit %></span><%== bar(c.crit_met, c.crit) %></a><a class="<%= c.verified == c.pieces ? "is-done" : "is-flight" %>" href="#record"><span class="label"><%== icon("archive") %>Work verified</span><span class="figure"><%= c.verified %>/<%= c.pieces %></span><%== bar(c.verified, c.pieces) %></a></nav>
