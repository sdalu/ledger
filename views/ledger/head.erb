<%# <%== carries the next step, the waker and the tiles, built by Head. %>
<header class="ledger-head"><h1><%= name %></h1><p class="next"><%== nxt %> <a href="#say-note"><%== icon("sticky-note") %>Leave a note</a></p><%== close %><p class="receipt">Ledger updated <%= updated %></p><details class="ledger-details" id="<%= lid %>-details"><summary>Ledger details</summary><p class="path"><%= path %> · changed <%= changed %></p><p class="status"><%== inline(status) %></p></details><%== waker %><%== tiles %></header>
