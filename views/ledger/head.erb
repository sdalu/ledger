<%# <%== carries the goal's line, the next step, the waker, the unread line and the tiles, built by Head. %>
<header class="ledger-head"><h1><%= name %></h1><% unless short.empty? %><p class="goal-line"><%== short %></p><% end %><p class="next"><%== nxt %> <a href="#say-note"><%== icon("sticky-note") %>Leave a note</a></p><div class="ledger-actions"><%== close %></div><%== unread %><p class="receipt">Ledger updated <%= updated %></p><details class="ledger-details" id="<%= lid %>-details"><summary>Details: <span class="details-state"><%= waking %></span></summary><p class="path"><%= path %> · changed <%= changed %></p><p class="status"><%== inline(status) %></p><%== waker %><%== abandon %></details><%== tiles %></header>
