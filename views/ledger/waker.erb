<%# The waker's switch and its wakes; <%== carries the icon alone. %>
<div class="waker" id="waker"><form class="waker-switch" method="post" action="/l/<%= lid %>/waker"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="waker" value="<%= on ? "off" : "on" %>"><span class="waker-state <%= on ? "is-on" : "is-off" %>"><%== icon("send") %>Waker <%= on ? "on" : "off" %></span><span class="waker-says"><%= on ? "an idle session is woken when an entry of yours waits" : "nothing wakes an idle session" %></span><button type="submit" class="a-waker"><%= on ? "Switch off" : "Switch on" %></button></form><% unless wakes.empty? %><details class="waker-wakes"><summary><%= wakes.size %> wake<%= "s" if wakes.size > 1 %></summary><table><thead><tr><th scope="col">Time</th><th scope="col">Path</th><th scope="col">Outcome</th></tr></thead><tbody><% wakes.each do |wake| %><tr><td><%= wake[:at] %></td><td><%= wake[:path] %></td><td><%= wake[:outcome] %></td></tr><% end %></tbody></table></details><% end %></div>
