<%# <%== carries the label, escaped once already, and the tip, built by WordForm. %>
<details class="drop-fold" id="<%= lid %>-drop-<%= ref %>"><summary aria-label="<%== label %>"<%== attrs %>><%== icon("trash-2") %><span class="drop-label">Close</span></summary><form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="<%= ref %>"><h4 class="drop-title"><%== label %></h4><p class="drop-says"><%= says %></p><label for="say-<%= ref %>-drop">Why? (optional)</label><textarea id="say-<%= ref %>-drop" name="text" maxlength="4000"></textarea><div class="actions"><button type="button" class="a-cancel" hidden>Cancel</button><button type="submit" name="word" value="drop" class="a-drop">Ask to close <%= ref %></button></div></form></details><%== box %>
