<%# <%== carries the buttons and the tip, built by WordForm. %>
<form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="<%= id %>"><% unless replaces.empty? %><input type="hidden" name="replaces" value="<%= replaces %>"><% end %><div class="word-choices"><%== buttons.join %></div><details class="comment-box" id="<%= lid %>-say-<%= id %>-word-comment"<% unless text.empty? %> open<% end %>><summary>Add a comment</summary><label for="say-<%= id %>-word">Comment on <%= id %></label><textarea id="say-<%= id %>-word" name="text" maxlength="4000"><%= text %></textarea><div class="actions"><button type="submit" class="a-comment"<%== attrs %>><%== icon("message-square") %>Send comment</button><%== box %><button type="button" class="a-quote" hidden disabled><%== icon("text-quote") %>Quote selection</button></div></details></form>
