<%# The ledger's Abandon, folded as its Close is: the fold opens the request, its button sends it. %>
<details class="abandon-fold" id="<%= lid %>-abandon"><summary><%== icon("circle-alert") %>Abandon the ledger</summary><form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="abandon"><h4 class="abandon-title">Abandon this ledger unfinished?</h4><p class="abandon-says"><%= says %></p><label for="say-abandon">Anything to say with it? (optional)</label><textarea id="say-abandon" name="text" maxlength="4000"></textarea><div class="actions"><button type="button" class="a-cancel" hidden>Cancel</button><button type="submit" class="a-abandon">Yes, abandon it</button></div></form></details>
