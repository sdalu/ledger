<%# <%== carries the chip, drawn by chip(), and the paragraphs and the words, built by Goals. %>
<section class="goal"><%== chip(id) %><%== parts.join %><details class="goal-words"<% unless key.empty? %> id="<%= key %>"<% end %><% if opened %> open<% end %>><summary><%= said %></summary><blockquote><div class="md"><%== words %></div></blockquote></details></section>
