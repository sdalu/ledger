<form class="give-all" method="post" action="/l/<%= lid %>/say-all"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="refs" value="<%= refs %>"><p>All <%= count %> await the same words: <%= names.join(", ") %></p><button type="submit" name="word" value="<%= names.join(", ") %>"><%== icon(symbol) %><%= labels.join(" + ") %> all <%= count %></button></form>
