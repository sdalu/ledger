<%# <%== carries the rows built by Inbox, each with its own escaping. %>
<h2 id="inbox"><%== icon("inbox") %>Your messages <span class="count"><%= count %></span></h2><% unless said.empty? %><ul class="entries"><%== said.join %></ul><% end %><% unless filed.empty? %><details class="done-fold" id="<%= lid %>-filed"><summary>Filed (<%= filed.length %>)</summary><ul class="entries"><%== filed.join %></ul></details><% end %><% if said.empty? && filed.empty? %><p>Nothing sent yet.</p><% end %>
