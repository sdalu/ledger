<%# The order and the risk filter of Waiting on you: drawn hidden, the script shows it and keeps the choice in the browser. %>
<div class="waiting-view" hidden><fieldset><legend>Order</legend><label><input type="radio" name="view-order" value="oldest" checked> Oldest wait</label><label><input type="radio" name="view-order" value="risk"> Highest risk</label></fieldset><fieldset><legend>Show</legend><label><input type="radio" name="view-show" value="all" checked> All</label><label><input type="radio" name="view-show" value="4"> Risk 4+</label><label><input type="radio" name="view-show" value="7"> Risk 7+</label></fieldset></div>
