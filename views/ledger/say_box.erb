<%# <%== is the quote button, below. %>
<% if folded %><details class="overall" id="<%= lid %>-<%= fid %>-overall"<% unless text.empty? %> open<% end %>><summary><%= what %></summary><textarea id="<%= fid %>" name="text" maxlength="4000" aria-label="<%= what %>"><%= text %></textarea><div class="actions"><button type="button" class="a-quote" hidden disabled><%== icon("text-quote") %>Quote last selection</button></div></details><% else %><textarea id="<%= fid %>" name="text" maxlength="4000" required><%= text %></textarea><div class="actions"><button type="button" class="a-quote" hidden disabled><%== icon("text-quote") %>Quote last selection</button></div><% end %>
