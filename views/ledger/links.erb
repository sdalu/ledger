<%# <%== carries the id chips, drawn by chip(), which escapes its text, and the crumbs line, built by the caller. %>
<% id_link = lambda do |id| %><% path = href.call(id) %><% if path %><a class="id-link" href="<%= path %>"><%== chip(id) %></a><% else %><%== chip(id) %><% end %><% end %>
<% walk = lambda do |nodes| %><ol><% nodes.each do |node| %><li class="<%= ["lineage-node", "is-#{node.kind}", node.state, ("is-root" if node.root?)].compact.join(" ") %>"><p class="node-head"><% if node.via %><span class="via"><%= node.via %></span> <% end %><% id_link.call(node.id) %> <% if node.title %><span class="title"><%= node.title %></span> <% end %><% if node.status %><span class="tag"><%= node.status %></span><% end %></p><% if node.quote %><blockquote class="words"><p class="whose">Your words</p><q><%= node.quote %></q></blockquote><% end %><% if node.text && !node.user_words %><p class="text"><%= node.text %></p><% end %><% if node.user_words && node.quote.nil? %><blockquote class="words"><p class="whose">Your words<% if node.date %> · <%= node.date %><% end %></p><q><%= node.text %></q></blockquote><% end %><% if node.kind == "X" && !node.user_words %><p class="whose">The session's call<% if node.date %> · <%= node.date %><% end %></p><% end %><% if node.note %><p class="note"><%= node.note %></p><% end %><% unless node.also.empty? %><p class="also"><% node.also.each do |label, ids| %><span><%= label %> <% ids.each do |also| %><% id_link.call(also) %> <% end %></span> <% end %></p><% end %><% walk.call(node.next_nodes) unless node.next_nodes.empty? %></li><% end %></ol><% end %>
<%== crumbs %><section class="links-graph" aria-labelledby="links-title"><header class="links-head"><h1 id="links-title">Why <a class="id-link" href="<%= card %>"><%== chip(view.start.id) %></a> <span class="title"><%= view.start.title || view.start.text %></span></h1><p class="receipt"><%= view.ledger %></p></header><% if view.back.empty? && view.forward.empty? %><p class="links-none">Nothing is linked to <%= view.start.id %>, before or after it. <a href="<%= card %>">Back to <%= view.start.id %> on the ledger page</a></p><% else %><div class="links-columns"><section class="links-back" aria-labelledby="links-back"><h2 id="links-back">Back to your words</h2><p class="meta">Each line below is a reason for the one above it.</p><% if view.back.empty? %><p class="meta">Nothing is linked behind <%= view.start.id %>.</p><% else %><% walk.call(view.back) %><% end %></section><section class="links-forward" aria-labelledby="links-forward"><h2 id="links-forward">What it led to</h2><p class="meta">Each line below came out of the one above it.</p><% if view.forward.empty? %><p class="meta">Nothing is linked after <%= view.start.id %>.</p><% else %><% walk.call(view.forward) %><% end %></section></div><% end %></section>
