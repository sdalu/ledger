<%# <%== carries the parts SayForm built, each with its own escaping. %>
<form class="say" method="post" action="/l/<%= lid %>/say"><input type="hidden" name="token" value="<%= token %>"><input type="hidden" name="ref" value="<%= ref %>"><% unless replaces.empty? %><input type="hidden" name="replaces" value="<%= replaces %>"><% end %><%== middle %><%== box %><%== built %><div class="actions"><button type="submit"<% unless starts.empty? %> class="a-answer-start" data-start="<%= starts %>"<% end %>><%== icon("send") %><%= submit %></button><%== after %></div></form>
