<%# The planned pieces as a list to reorder, which the script shows and keeps written into the order field; <%== carries the chips, the titles drawn by inline(), and the icons. %>
<ol class="order-list" hidden aria-label="Proposed order, first to last"><% pieces.each do |id, title| %><li data-id="<%= id %>"><span class="order-text"><%== chip(id) %> <%== inline(title) %></span><span class="order-moves"><button type="button" class="a-up" aria-label="Move <%= id %> up"><%== icon("arrow-up") %></button><button type="button" class="a-down" aria-label="Move <%= id %> down"><%== icon("arrow-down") %></button></span></li><% end %></ol>
