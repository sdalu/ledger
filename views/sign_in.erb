<h1>Sign in</h1>
<form method="post" data-page="sign-in" data-endpoint="<%= to("/session/password", false) %>"
      data-next="<%= to("/", false) %>">
<p><label>Name <input name="name" autocomplete="username" required></label></p>
<p><label>Password <input name="password" type="password"
   autocomplete="current-password" required></label></p>
<p><button>Sign in</button></p>
<p class="problem" role="alert" hidden></p>
</form>
<script src="<%= to("/pages.js", false) %>"></script>
