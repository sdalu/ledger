<%# <%== carries markup the helpers built: the chip and the icon. %>
<li class="is-ask" data-key="q:<%= lid %>:<%= anchor %>">
<% unless wait.empty? %><span class="wait"><%= wait %></span><% end %>
<div class="question"><span class="title"><%== chip(id) %> <strong><%= title %></strong></span>
<span class="where"><a href="/l/<%= lid %>"><%= name %></a> · <%= what %><%= risk %></span></div>
<a class="answer" href="/l/<%= lid %>#<%= anchor %>"><%= label %><span class="visually-hidden"> <%= title %> in <%= name %></span><%== icon("arrow-right") %></a></li>
